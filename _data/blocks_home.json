[
    {
        "id": "hero",
        "nome": "Hero",
        "enabled": true,
        "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n#main-content{--ink:#15191d;--line:#eadfd2;--warm:#fbf3ea;--muted:#54483c;--y:#ff8a1f;--gd:#d9480f;--deep:#7c2d0a;--d:'Archivo Narrow','Arial Narrow',sans-serif;--ease:cubic-bezier(.16,1,.3,1)}\n#main-content ::selection{background:#ff8a1f;color:#15191d}\n.ex-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 1.6rem;font-family:var(--d);font-weight:700;font-size:1.05rem;border-radius:2px;text-decoration:none;border:1px solid transparent;transition:background-color .2s var(--ease),border-color .2s var(--ease)}\n.ex-btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}.ex-end .ex-btn:focus-visible{outline-color:var(--y)}\n.ex-btn-y{background:var(--y);color:var(--ink)}.ex-btn-y:hover{background:#ffb347}\n.ex-btn-o{border-color:#8b9580;color:var(--ink)}.ex-btn-o:hover{border-color:var(--ink)}\n.ex-btn-k{background:var(--ink);color:#fff}.ex-btn-k:hover{background:#2a323a}\n.ex-band .ex-btn:focus-visible{outline-color:var(--ink)}\n.ex-hero{background:#eef3e4;color:var(--ink);box-sizing:border-box;display:flex;align-items:center;min-height:calc(100vh - 80px);min-height:calc(100svh - 80px);padding:clamp(1.5rem,4vh,4rem) 1.5rem}\n.ex-hero-in{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-hero h1{font-family:var(--d);font-weight:700;font-size:clamp(2.5rem,5.4vw,4.4rem);line-height:1;letter-spacing:-.01em;color:var(--ink);margin:0 0 1.5rem;max-width:12ch;text-wrap:balance}\n.ex-hero p{font-size:1.1rem;line-height:1.6;color:#3d444a;max-width:46ch;margin:0 0 2rem}\n.ex-actions{display:flex;gap:1rem;flex-wrap:wrap}\n.ex-fig{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:1.5rem;align-items:stretch}\n.ex-fig svg{width:100%;height:auto;max-height:min(520px,calc(100svh - 11rem));display:block}\n.ex-stats{display:flex;flex-direction:column;justify-content:space-between;padding:0 0 1.5rem;margin:0;list-style:none}\n.ex-stats li{border-top:1px solid #b9c4a6;padding-top:.75rem;margin:0}\n.ex-num{display:block;font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,2.8rem);line-height:1;color:var(--gd);font-variant-numeric:tabular-nums}\n.ex-lab{display:block;font-size:.92rem;line-height:1.4;color:#54483c;margin-top:.35rem}\n.ex-rope,.ex-rope2{stroke-dasharray:1;animation:ex-draw 1.8s var(--ease) both}\n.ex-man{animation:ex-drop 1.8s var(--ease) both}.ex-sway{transform-origin:0 -60px;animation:ex-sway 4.2s ease-in-out 1.8s infinite alternate}.ex-legs{transform-origin:0 2px;animation:ex-push 2.6s ease-in-out 1.8s infinite alternate}\n@keyframes ex-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}\n@keyframes ex-drop{from{transform:translateY(-222px)}}@keyframes ex-sway{from{transform:rotate(-1.4deg)}to{transform:rotate(1.4deg)}}@keyframes ex-push{from{transform:rotate(0)}to{transform:rotate(-4deg)}}\n@media (prefers-reduced-motion:reduce){.ex-rope,.ex-rope2,.ex-man,.ex-sway,.ex-legs{animation:none}}\n.ex-sec{padding:clamp(3.5rem,8vw,6.5rem) 1.5rem;background:#fff}\n.ex-sec-warm{background:var(--warm)}\n.ex-wrap{max-width:1180px;margin:0 auto}\n.ex-h2{font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,3rem);line-height:1.08;color:var(--ink);margin:0;text-wrap:balance}\n.ex-2col{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-lead{font-size:1.1rem;line-height:1.65;color:var(--muted);max-width:38ch;margin:1.25rem 0 0}\n.ex-pts{list-style:none;margin:0;padding:0}\n.ex-pts li{padding:1.25rem 0;border-top:1px solid #d6d3c9;margin:0}.ex-pts li:last-child{border-bottom:1px solid #d6d3c9}\n.ex-pts b{display:block;font-family:var(--d);font-size:1.35rem;line-height:1.2;color:var(--ink);margin-bottom:.3rem}\n.ex-pts span{font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5rem;margin-top:3rem}\n.ex-grid3>div{border-top:2px solid var(--ink);padding-top:1rem}\n.ex-grid3 h3{font-family:var(--d);font-size:1.35rem;font-weight:700;color:var(--ink);margin:0 0 .4rem;line-height:1.2}\n.ex-grid3 p{margin:0;font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-svc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;padding-bottom:1.75rem;border-bottom:2px solid var(--ink)}\n.ex-svc-head p{margin:0;color:var(--muted);max-width:34ch;font-size:1.02rem;line-height:1.5}\n.ex-svcs{display:grid;grid-template-columns:repeat(2,1fr);column-gap:3rem}\n.ex-svc{display:grid;grid-template-columns:1fr auto;gap:.25rem 1rem;align-items:center;padding:1.3rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:background-color .2s var(--ease),padding .2s var(--ease)}\n.ex-svc:hover{background:var(--warm);padding-left:.9rem}\n.ex-svc:focus-visible{outline:3px solid var(--ink);outline-offset:-3px}\n.ex-svc-t{font-family:var(--d);font-weight:700;font-size:1.25rem;line-height:1.2;color:var(--ink)}\n.ex-svc-d{grid-column:1;font-size:.95rem;line-height:1.5;color:var(--muted)}\n.ex-svc svg{grid-column:2;grid-row:1/span 2;width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:2;transition:transform .2s var(--ease)}\n.ex-svc:hover svg{transform:translateX(4px)}\n.ex-band{background:var(--y);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-end{background:var(--deep);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-band-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap}\n.ex-band p{margin:.6rem 0 0;color:#2c3136;font-size:1.1rem;line-height:1.5}\n.ex-end .ex-h2{color:#fff}.ex-end p{margin:.6rem 0 0;color:#d7e2c6;font-size:1.1rem;line-height:1.5}\n@media (max-width:820px){.ex-hero-in,.ex-2col{grid-template-columns:1fr}.ex-fig{max-width:440px}.ex-grid3{grid-template-columns:1fr 1fr}.ex-svcs{grid-template-columns:1fr}}\n@media (max-width:560px){.ex-grid3{grid-template-columns:1fr}.ex-sec,.ex-hero,.ex-band,.ex-end{padding-left:1.25rem;padding-right:1.25rem}}\n</style>\n<header class=\"ex-hero\" aria-label=\"Hero\"><div class=\"ex-hero-in\"><div><h1>Prodotti digitali pronti all'uso.</h1><p>Template di siti, plugin, fogli Excel, modelli di testi, prompt, workflow n8n e guide: li scegli, li adatti e risparmi ore di lavoro. Pre-ordina ora, nessun pagamento anticipato.</p><div class=\"ex-actions\"><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/negozio/\">Sfoglia il negozio</a><a class=\"ex-btn ex-btn-o\" href=\"#categorie\">Guarda le categorie</a></div></div><figure class=\"ex-fig\" style=\"grid-template-columns:1fr\"><ul class=\"ex-stats\"><li><span class=\"ex-num\">da 15 &euro;</span><span class=\"ex-lab\">ebook e guide pratiche</span></li><li><span class=\"ex-num\">da 19 &euro;</span><span class=\"ex-lab\">fogli Excel, testi e prompt</span></li><li><span class=\"ex-num\">da 49 &euro;</span><span class=\"ex-lab\">template di siti completi</span></li></ul></figure></div></header>"
    },
    {
        "id": "whatis",
        "nome": "Perche' prodotti digitali pronti",
        "enabled": true,
        "html": "<section class=\"ex-sec\" id=\"whatis\" aria-labelledby=\"whatis-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"whatis-title\">Perche' prodotti digitali pronti</h2><p class=\"ex-lead\">Rifare ogni volta da zero un preventivo, un foglio di calcolo o un sito costa tempo. Qui trovi il lavoro di base gia' fatto: lo adatti e parti.</p></div><ol class=\"ex-pts\"><li><b>Risparmi ore</b><span>la parte lunga e' gia' pronta, tu sistemi solo i dettagli.</span></li><li><b>Compri solo quello che serve</b><span>un prodotto alla volta, senza pacchetti obbligati.</span></li><li><b>Mestieri italiani</b><span>forfettari, condomini, artigiani, ristoranti, agenzie immobiliari.</span></li><li><b>Nessun pagamento ora</b><span>pre-ordini e ti scriviamo quando il prodotto e' pronto.</span></li></ol></div></section>"
    },
    {
        "id": "stack",
        "nome": "Sei motivi per sceglierci",
        "enabled": true,
        "html": "<section class=\"ex-sec ex-sec-warm\" id=\"stack\" aria-labelledby=\"stack-title\"><div class=\"ex-wrap\"><h2 class=\"ex-h2\" id=\"stack-title\">Sei motivi per sceglierci</h2><div class=\"ex-grid3\"><div><h3>Prezzi chiari</h3><p>Il prezzo e' scritto accanto a ogni prodotto.</p></div><div><h3>Pronti all'uso</h3><p>Prodotti fatti per essere adattati, non costruiti da zero.</p></div><div><h3>Per l'Italia</h3><p>Temi e mestieri italiani, in italiano.</p></div><div><h3>Nessun pagamento ora</h3><p>Pre-ordini e ti scriviamo quando e' pronto.</p></div><div><h3>Supporto in italiano</h3><p>Scrivici dalla pagina Contatti.</p></div><div><h3>Scegli tu</h3><p>Prendi solo il prodotto che ti serve.</p></div></div></div></section>"
    },
    {
        "id": "features",
        "nome": "Categorie",
        "enabled": true,
        "html": "<section class=\"ex-sec\" id=\"categorie\" aria-labelledby=\"features-title\"><div class=\"ex-wrap\"><div class=\"ex-svc-head\"><h2 class=\"ex-h2\" id=\"features-title\">Categorie</h2><p>Diciannove gruppi di prodotti digitali: scegli quello che ti serve.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/template/\"><span class=\"ex-svc-t\">Template siti Jekyll</span><span class=\"ex-svc-d\">Siti gia' pronti per artigiani, ristoranti e altre attivita'.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/plugin/\"><span class=\"ex-svc-t\">Moduli e plugin PHP</span><span class=\"ex-svc-d\">Add-on per CartaCMS e altri CMS: nuove funzioni da installare.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/testi/\"><span class=\"ex-svc-t\">Modelli di testi</span><span class=\"ex-svc-d\">Preventivi, contratti tipo, solleciti e checklist da adattare.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/excel/\"><span class=\"ex-svc-t\">Fogli Excel pronti</span><span class=\"ex-svc-d\">Fogli di calcolo per forfettari, condomini e preventivi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/prompt/\"><span class=\"ex-svc-t\">Prompt e skill Claude</span><span class=\"ex-svc-d\">Prompt e skill Claude pensati per mestieri precisi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/n8n/\"><span class=\"ex-svc-t\">Workflow n8n</span><span class=\"ex-svc-d\">Automazioni n8n da importare: preventivi, lead e avvisi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/guide/\"><span class=\"ex-svc-t\">Ebook e guide</span><span class=\"ex-svc-d\">Guide pratiche in PDF, spiegate passo passo.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/stampabili/\"><span class=\"ex-svc-t\">Stampabili</span><span class=\"ex-svc-d\">Moduli, registri e checklist da stampare e compilare.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/bundle/\"><span class=\"ex-svc-t\">Bundle</span><span class=\"ex-svc-d\">Pacchetti completi per un mestiere, a prezzo conveniente.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/planner/\"><span class=\"ex-svc-t\">Planner</span><span class=\"ex-svc-d\">Agende, piani e tracker per organizzare giorni e obiettivi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/canva/\"><span class=\"ex-svc-t\">Canva</span><span class=\"ex-svc-d\">Template modificabili per grafiche, menu e presentazioni.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/notion/\"><span class=\"ex-svc-t\">Notion</span><span class=\"ex-svc-d\">Template Notion per progetti, clienti e abitudini.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/wallart/\"><span class=\"ex-svc-t\">Wall art</span><span class=\"ex-svc-d\">Stampe da parete da scaricare e stampare.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/clipart/\"><span class=\"ex-svc-t\">SVG e clipart</span><span class=\"ex-svc-d\">Icone e illustrazioni vettoriali per i tuoi progetti.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/scuola/\"><span class=\"ex-svc-t\">Materiale didattico</span><span class=\"ex-svc-d\">Schede e risorse per insegnanti e genitori.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/lavoro/\"><span class=\"ex-svc-t\">CV e portfolio</span><span class=\"ex-svc-d\">Curriculum e portfolio modificabili per candidarsi meglio.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/social/\"><span class=\"ex-svc-t\">Social media</span><span class=\"ex-svc-d\">Calendari editoriali e post pronti per i social.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/eventi/\"><span class=\"ex-svc-t\">Inviti e feste</span><span class=\"ex-svc-d\">Inviti, biglietti e materiali per eventi e ricorrenze.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/negozio/categoria/sheets/\"><span class=\"ex-svc-t\">Google Sheets</span><span class=\"ex-svc-d\">Fogli Google pronti per budget, scadenze e gestione.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div></div></section>"
    },
    {
        "id": "pricing",
        "nome": "Pre-ordine",
        "enabled": true,
        "html": "<section class=\"ex-band\" id=\"pricing\" aria-labelledby=\"pricing-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"pricing-title\">Pre-ordina i tuoi prodotti</h2><p>Nessun pagamento ora: ti scriviamo appena il prodotto e' pronto.</p></div><a class=\"ex-btn ex-btn-k\" href=\"__BASEURL__/negozio/\">Vai al negozio</a></div></section>"
    },
    {
        "id": "cta",
        "nome": "CTA finale",
        "enabled": false,
        "html": "<section class=\"ex-end\" aria-labelledby=\"cta-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"cta-title\">Cerchi un prodotto che non c'e'?</h2><p>Scrivici: se ci sono richieste lo prepariamo prima.</p></div><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/contatti/\">Contattaci</a></div></section>"
    }
