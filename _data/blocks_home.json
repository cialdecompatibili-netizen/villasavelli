[
    {
        "id": "hero",
        "nome": "Hero",
        "enabled": true,
        "html": "<style>\n#main-content{--ink:#15191d;--line:#eadfd2;--warm:#fbf3ea;--muted:#54483c;--y:#b9d6a8;--gd:#3b6b4a;--deep:#26402f;--d:'Archivo Narrow','Arial Narrow',sans-serif;--ease:cubic-bezier(.16,1,.3,1)}\n#main-content ::selection{background:#b9d6a8;color:#15191d}\n.ex-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 1.6rem;font-family:var(--d);font-weight:700;font-size:1.05rem;border-radius:2px;text-decoration:none;border:1px solid transparent;transition:background-color .2s var(--ease),border-color .2s var(--ease)}\n.ex-btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}.ex-end .ex-btn:focus-visible{outline-color:var(--y)}\n.ex-btn-y{background:var(--y);color:var(--ink)}.ex-btn-y:hover{background:#cfe5c1}\n.ex-btn-o{border-color:#8b9580;color:var(--ink)}.ex-btn-o:hover{border-color:var(--ink)}\n.ex-btn-k{background:var(--ink);color:#fff}.ex-btn-k:hover{background:#2a323a}\n.ex-band .ex-btn:focus-visible{outline-color:var(--ink)}\n.ex-hero{background:#eef3e4;color:var(--ink);box-sizing:border-box;display:flex;align-items:center;min-height:calc(100vh - 80px);min-height:calc(100svh - 80px);padding:clamp(1.5rem,4vh,4rem) 1.5rem}\n.ex-hero-in{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-hero h1{font-family:var(--d);font-weight:700;font-size:clamp(2.5rem,5.4vw,4.4rem);line-height:1;letter-spacing:-.01em;color:var(--ink);margin:0 0 1.5rem;max-width:12ch;text-wrap:balance}\n.ex-hero p{font-size:1.1rem;line-height:1.6;color:#3d444a;max-width:46ch;margin:0 0 2rem}\n.ex-actions{display:flex;gap:1rem;flex-wrap:wrap}\n.ex-fig{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:1.5rem;align-items:stretch}\n.ex-fig svg{width:100%;height:auto;max-height:min(520px,calc(100svh - 11rem));display:block}\n.ex-stats{display:flex;flex-direction:column;justify-content:space-between;padding:0 0 1.5rem;margin:0;list-style:none}\n.ex-stats li{border-top:1px solid #b9c4a6;padding-top:.75rem;margin:0}\n.ex-num{display:block;font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,2.8rem);line-height:1;color:var(--gd);font-variant-numeric:tabular-nums}\n.ex-lab{display:block;font-size:.92rem;line-height:1.4;color:#54483c;margin-top:.35rem}\n.ex-rope,.ex-rope2{stroke-dasharray:1;animation:ex-draw 1.8s var(--ease) both}\n.ex-man{animation:ex-drop 1.8s var(--ease) both}.ex-sway{transform-origin:0 -60px;animation:ex-sway 4.2s ease-in-out 1.8s infinite alternate}.ex-legs{transform-origin:0 2px;animation:ex-push 2.6s ease-in-out 1.8s infinite alternate}\n@keyframes ex-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}\n@keyframes ex-drop{from{transform:translateY(-222px)}}@keyframes ex-sway{from{transform:rotate(-1.4deg)}to{transform:rotate(1.4deg)}}@keyframes ex-push{from{transform:rotate(0)}to{transform:rotate(-4deg)}}\n@media (prefers-reduced-motion:reduce){.ex-rope,.ex-rope2,.ex-man,.ex-sway,.ex-legs{animation:none}}\n.ex-sec{padding:clamp(3.5rem,8vw,6.5rem) 1.5rem;background:#fff}\n.ex-sec-warm{background:var(--warm)}\n.ex-wrap{max-width:1180px;margin:0 auto}\n.ex-h2{font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,3rem);line-height:1.08;color:var(--ink);margin:0;text-wrap:balance}\n.ex-2col{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-lead{font-size:1.1rem;line-height:1.65;color:var(--muted);max-width:38ch;margin:1.25rem 0 0}\n.ex-pts{list-style:none;margin:0;padding:0}\n.ex-pts li{padding:1.25rem 0;border-top:1px solid #d6d3c9;margin:0}.ex-pts li:last-child{border-bottom:1px solid #d6d3c9}\n.ex-pts b{display:block;font-family:var(--d);font-size:1.35rem;line-height:1.2;color:var(--ink);margin-bottom:.3rem}\n.ex-pts span{font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5rem;margin-top:3rem}\n.ex-grid3>div{border-top:2px solid var(--ink);padding-top:1rem}\n.ex-grid3 h3{font-family:var(--d);font-size:1.35rem;font-weight:700;color:var(--ink);margin:0 0 .4rem;line-height:1.2}\n.ex-grid3 p{margin:0;font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-svc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;padding-bottom:1.75rem;border-bottom:2px solid var(--ink)}\n.ex-svc-head p{margin:0;color:var(--muted);max-width:34ch;font-size:1.02rem;line-height:1.5}\n.ex-svcs{display:grid;grid-template-columns:repeat(2,1fr);column-gap:3rem}\n.ex-svc{display:grid;grid-template-columns:1fr auto;gap:.25rem 1rem;align-items:center;padding:1.3rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:background-color .2s var(--ease),padding .2s var(--ease)}\n.ex-svc:hover{background:var(--warm);padding-left:.9rem}\n.ex-svc:focus-visible{outline:3px solid var(--ink);outline-offset:-3px}\n.ex-svc-t{font-family:var(--d);font-weight:700;font-size:1.25rem;line-height:1.2;color:var(--ink)}\n.ex-svc-d{grid-column:1;font-size:.95rem;line-height:1.5;color:var(--muted)}\n.ex-svc svg{grid-column:2;grid-row:1/span 2;width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:2;transition:transform .2s var(--ease)}\n.ex-svc:hover svg{transform:translateX(4px)}\n.ex-band{background:var(--y);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-end{background:var(--deep);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-band-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap}\n.ex-band p{margin:.6rem 0 0;color:#2c3136;font-size:1.1rem;line-height:1.5}\n.ex-end .ex-h2{color:#fff}.ex-end p{margin:.6rem 0 0;color:#d7e2c6;font-size:1.1rem;line-height:1.5}\n@media (max-width:820px){.ex-hero-in,.ex-2col{grid-template-columns:1fr}.ex-fig{max-width:440px}.ex-grid3{grid-template-columns:1fr 1fr}.ex-svcs{grid-template-columns:1fr}}\n@media (max-width:560px){.ex-grid3{grid-template-columns:1fr}.ex-sec,.ex-hero,.ex-band,.ex-end{padding-left:1.25rem;padding-right:1.25rem}}\n</style>\n<header class=\"ex-hero\" aria-label=\"Hero\"><div class=\"ex-hero-in\"><div><h1>Una base tranquilla per visitare Roma e il Lazio.</h1><p>A Mentana, una villa con camere e posti letto per turisti, studenti e chi lavora da remoto. Di giorno visiti, la sera torni in una casa silenziosa. Regole chiare, niente feste.</p><div class=\"ex-actions\"><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/contatti/\">Richiedi disponibilit&agrave;</a><a class=\"ex-btn ex-btn-o\" href=\"#offerte\">Guarda le formule</a></div></div><figure class=\"ex-fig\" style=\"grid-template-columns:1fr\"><ul class=\"ex-stats\"><li><span class=\"ex-num\">8 min</span><span class=\"ex-lab\">a piedi dalla fermata del bus</span></li><li><span class=\"ex-num\">4-6</span><span class=\"ex-lab\">letti al massimo per stanza</span></li><li><span class=\"ex-num\">0</span><span class=\"ex-lab\">feste ed eventi: qui si studia e si riposa</span></li></ul></figure></div></header>"
    },
    {
        "id": "whatis",
        "nome": "Pensata per chi ha bisogno di calma",
        "enabled": true,
        "html": "<section class=\"ex-sec\" id=\"whatis\" aria-labelledby=\"whatis-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"whatis-title\">Pensata per chi ha bisogno di calma</h2><p class=\"ex-lead\">Una casa dove concentrarsi: orari rispettati, spazi per studiare e lavorare, ospiti scelti con attenzione.</p></div><ol class=\"ex-pts\"><li><b>Base per Roma e il Lazio</b><span>dormi fuori dal caos del centro, con la fermata del bus a 8 minuti a piedi. Linee e tempi per Roma: in definizione.</span></li><li><b>Silenzio e regole chiare</b><span>niente feste, orari di quiete, regole scritte prima di prenotare.</span></li><li><b>Studio e smart working</b><span>aula studio e coworking a disposizione di chi alloggia, con wifi incluso.</span></li><li><b>Attenzione alle studentesse</b><span>camere dedicate, disponibilit&agrave; da confermare scrivendoci.</span></li><li><b>Prezzi per persona</b><span>posto letto, camera singola o B&amp;B: scegli la formula pi&ugrave; adatta al tuo budget.</span></li></ol></div></section>"
    },
    {
        "id": "stack",
        "nome": "Per chi e",
        "enabled": true,
        "html": "<section class=\"ex-sec ex-sec-warm\" id=\"perchi\" aria-labelledby=\"stack-title\"><div class=\"ex-wrap\"><h2 class=\"ex-h2\" id=\"stack-title\">Per chi &egrave;</h2><div class=\"ex-grid3\"><div><h3>Turisti e cicloturisti</h3><p>Roma, Lazio, ciclabile del Tevere e Marcigliana: esplori di giorno, riposi la sera.</p></div><div><h3>Studentesse</h3><p>Un ambiente sereno per studiare, con regole chiare e ospiti tranquilli.</p></div><div><h3>Studenti e tirocinanti</h3><p>Posti letto economici, per settimane o mesi.</p></div><div><h3>Smart worker</h3><p>Soggiorni lunghi con scrivania, wifi e silenzio.</p></div><div><h3>Lavoratori in trasferta</h3><p>Tariffe settimanali per turnisti, cantieri e ospedali.</p></div><div><h3>Gruppi tranquilli</h3><p>Villa intera per ritiri di studio o scrittura, senza feste.</p></div></div></div></section>"
    },
    {
        "id": "features",
        "nome": "Le formule",
        "enabled": true,
        "html": "<section class=\"ex-sec\" id=\"offerte\" aria-labelledby=\"features-title\"><div class=\"ex-wrap\"><div class=\"ex-svc-head\"><h2 class=\"ex-h2\" id=\"features-title\">Le formule</h2><p>Prezzi in definizione: scrivici per disponibilit&agrave; e tariffe aggiornate.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"__BASEURL__/posto-letto-economico/\"><span class=\"ex-svc-t\">Posto letto economico</span><span class=\"ex-svc-d\">Letto in camera da 4-6 persone, con armadietto, luce e presa personale.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/soggiorni-lunghi/\"><span class=\"ex-svc-t\">Soggiorni lunghi</span><span class=\"ex-svc-d\">Settimane o mesi per studenti e smart worker.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/coworking/\"><span class=\"ex-svc-t\">Coworking e aula studio</span><span class=\"ex-svc-d\">Scrivanie e sala riunioni a ore, anche per chi non alloggia.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/contatti/?offerta=singola\"><span class=\"ex-svc-t\">Camera singola</span><span class=\"ex-svc-d\">Pi&ugrave; privacy, stessi spazi comuni.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/contatti/?offerta=bb\"><span class=\"ex-svc-t\">B&amp;B</span><span class=\"ex-svc-d\">Camera con colazione, ideale per turisti e soggiorni brevi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/contatti/?offerta=villa-intera\"><span class=\"ex-svc-t\">Villa intera</span><span class=\"ex-svc-d\">Per gruppi tranquilli: ritiri di studio, scrittura, yoga.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/contatti/?offerta=convenzione\"><span class=\"ex-svc-t\">Convenzioni</span><span class=\"ex-svc-d\">Tariffe dedicate ad aziende, cantieri, ospedali e scuole.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"__BASEURL__/mentana-e-dintorni/\"><span class=\"ex-svc-t\">Mentana e dintorni</span><span class=\"ex-svc-d\">Museo Garibaldino, centro storico e come raggiungere Roma.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div></div></section>"
    },
    {
        "id": "pricing",
        "nome": "Richiedi disponibilita",
        "enabled": true,
        "html": "<section class=\"ex-band\" id=\"pricing\" aria-labelledby=\"pricing-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"pricing-title\">Richiedi disponibilit&agrave;</h2><p>Nessun pagamento ora: ci dici cosa cerchi e ti rispondiamo con tariffe e date libere.</p></div><a class=\"ex-btn ex-btn-k\" href=\"__BASEURL__/contatti/\">Scrivici</a></div></section>"
    },
    {
        "id": "cta",
        "nome": "Regole e FAQ",
        "enabled": true,
        "html": "<section class=\"ex-end\" aria-labelledby=\"cta-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"cta-title\">Prima di prenotare, leggi le regole</h2><p>Orari di quiete, cucina, ospiti: tutto scritto in modo semplice.</p></div><a class=\"ex-btn ex-btn-y\" href=\"__BASEURL__/regole-e-faq/\">Regole e FAQ</a></div></section>"
    }
